{
  "rules": {
    "ca": {
      ".read": true,
      "$col": {
        "$doc": {
          ".write": true,
          ".validate": "newData.child('j').isString() && newData.child('j').val().length < 100000 && newData.child('t').isNumber()"
        }
      }
    },
    "room": {
      ".read": true,
      "$peer": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.child('j').isString() && newData.child('j').val().length < 20000)"
      }
    },
    "locks": {
      "$lock": {
        ".read": true,
        ".write": true
      }
    },
    "acc": {
      "$a": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['n','s','h','u'])"
      }
    }
  }
}